GOOGLE_API_KEY=YOUR_API_KEY_HERE
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-2.5-flash
TOALPHA_MCP_URL=https://toalpha.tw/mcp
# Retry ownership: SDK attempts=1; application 1 initial + max_retries.
AGENT_MAX_RETRIES=3
AGENT_INITIAL_BACKOFF=2
AGENT_MAX_BACKOFF=15
GEMINI_REQUEST_TIMEOUT=60
MCP_TOOL_TIMEOUT=30
AGENT_TASK_DEADLINE=240
# FinMind is disabled by default. Review licensing/quota before opting in.
FINMIND_ENABLED=0
FINMIND_TOKEN=
